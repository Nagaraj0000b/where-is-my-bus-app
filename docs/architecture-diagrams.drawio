  </diagram>

  <!-- PAGE 2: COMPONENT & CLASS DIAGRAM -->
  <diagram id="component-class-diag" name="2. Component &amp; Class Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- SUB-SYSTEM 1: FLUTTER APP -->
        <mxCell id="pkg_app" value="&lt;&lt;Component&gt;&gt;&#xa;Frontend: Flutter Mobile Client (Dart + Riverpod)" style="shape=folder;fontStyle=1;tabWidth=160;tabHeight=30;tabPosition=left;html=1;boundedLbl=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=14;fontColor=#0369a1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="320" height="740" as="geometry" />
        </mxCell>

        <mxCell id="cls_homeshell" value="&lt;&lt;Widget / State&gt;&gt;&#xa;HomeShell &amp; AuthGate&#xa;--&#xa;+ activeTab: int&#xa;+ currentUser: User?&#xa;--&#xa;+ switchTab(index: int)&#xa;+ checkTokenOnLaunch()" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cls_journeyscreen" value="&lt;&lt;Widget&gt;&gt;&#xa;JourneyScreen&#xa;--&#xa;- fromPlace: PlaceSuggestion?&#xa;- toPlace: PlaceSuggestion?&#xa;- locating: bool&#xa;--&#xa;+ useMyLocation()&#xa;+ searchJourney()&#xa;+ renderConfidenceCard()" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cls_routemap" value="&lt;&lt;Widget&gt;&gt;&#xa;RouteMapWidget (flutter_map)&#xa;--&#xa;+ routePolyline: List&lt;LatLng&gt;&#xa;+ startPin: LatLng&#xa;+ destPin: LatLng&#xa;+ liveBusMarker: LatLng?&#xa;--&#xa;+ renderOpenStreetMap()" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cls_apiclient" value="&lt;&lt;Service&gt;&gt;&#xa;ApiClient&#xa;--&#xa;+ baseUrl: String&#xa;--&#xa;+ fetchJourney(from, to): JourneyResult&#xa;+ fetchByHour(from, to): HourlyResult&#xa;+ searchStops(query): List&lt;Place&gt;&#xa;+ searchRoutes(query): List&lt;Route&gt;&#xa;+ postCrowdsourcePing(telemetry)" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- SUB-SYSTEM 2: BACKEND FASTIFY -->
        <mxCell id="pkg_api" value="&lt;&lt;Component&gt;&gt;&#xa;Backend: Fastify Server (TypeScript / Node 25)" style="shape=folder;fontStyle=1;tabWidth=160;tabHeight=30;tabPosition=left;html=1;boundedLbl=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=14;fontColor=#15803d;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="340" height="740" as="geometry" />
        </mxCell>

        <mxCell id="cls_server" value="&lt;&lt;HTTP Controller&gt;&gt;&#xa;FastifyServer (server.ts)&#xa;--&#xa;+ GET /journey (from, to, at)&#xa;+ GET /journey/by-hour (from, to)&#xa;+ GET /eta (route, from, to, at)&#xa;+ GET /stops/near &amp; /stops/search&#xa;+ GET /routes/search &amp; /:id/stops&#xa;+ POST /auth/signup &amp; /login&#xa;+ POST /crowdsource/ping" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cls_journeyplanner" value="&lt;&lt;Domain Engine&gt;&gt;&#xa;JourneyPlanner (journey.ts)&#xa;--&#xa;- walkSpeed: 80 m/min&#xa;- walkRadius: 800m&#xa;--&#xa;+ planJourney(coords): JourneyOptions&#xa;+ planByHour(coords, dayType): BestWorst&#xa;- rankByTotalTime(walk, wait, ride)" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="270" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cls_etaengine" value="&lt;&lt;Domain Engine&gt;&gt;&#xa;EtaEngine (eta.ts)&#xa;--&#xa;+ estimateArrival(route, from, to, at)&#xa;+ computeResidualBand(hops, dayType)&#xa;+ describeConfidence(quality, hops): Trust" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="410" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cls_authservice" value="&lt;&lt;Service&gt;&gt;&#xa;AuthService (auth.ts)&#xa;--&#xa;+ createAccount(email, password)&#xa;+ checkLogin(email, password)&#xa;+ verifyJwt(token): UserId" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="530" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cls_dbpool" value="&lt;&lt;Infrastructure&gt;&gt;&#xa;DbPool (db.ts)&#xa;--&#xa;+ pool: pg.Pool&#xa;--&#xa;+ query(sql, params): Promise&lt;Rows&gt;" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- SUB-SYSTEM 3: DATABASE / PIPELINE -->
        <mxCell id="pkg_db" value="&lt;&lt;Component&gt;&gt;&#xa;Data Layer: PostgreSQL 17 + PostGIS" style="shape=folder;fontStyle=1;tabWidth=160;tabHeight=30;tabPosition=left;html=1;boundedLbl=1;fillColor=#fdf4ff;strokeColor=#c026d3;strokeWidth=2;fontSize=14;fontColor=#a21caf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="820" y="40" width="310" height="740" as="geometry" />
        </mxCell>

        <mxCell id="cls_tbl_static" value="&lt;&lt;Static GTFS Relational Tables&gt;&gt;&#xa;• stops (stop_id, name, lat, lon, geom)&#xa;• routes (route_id, short_name, desc)&#xa;• trips (trip_id, route_id, shape_id)&#xa;• shapes (shape_id, lat, lon, dist_m)&#xa;• stop_times (trip_id, stop_id, dist_m)" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cls_tbl_places" value="&lt;&lt;Spatial Graph Indexes&gt;&gt;&#xa;• stop_place (stop_id, place_id)&#xa;• route_places (route_id, place_id, seq)&#xa;• place_frequency (headway &amp; gaps)" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="230" width="270" height="90" as="geometry" />
        </mxCell>

        <mxCell id="cls_tbl_realtime" value="&lt;&lt;Cleaned Telemetry Storage&gt;&gt;&#xa;• realtime_frame (frame_id, timestamp)&#xa;• vehicle_position (vehicle_id, lat, lon)&#xa;• vehicle_progress (dist_m, accepted)" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="340" width="270" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cls_tbl_traveltimes" value="&lt;&lt;Mined Travel Times (Statistical)&gt;&gt;&#xa;• observed_stop_passage (9.73M rows)&#xa;• route_segment_travel_time (68k rows)&#xa;  [mean, median, p25, p75 by hour/daytype]&#xa;• eta_calibration_fold (7-fold CV bands)" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="460" width="270" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cls_tbl_auth" value="&lt;&lt;Security / Auth&gt;&gt;&#xa;• users (id, email, password_hash)&#xa;• sessions (token, user_id, expires_at)" style="shape=rect;rounded=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.5;fontSize=11;fontColor=#0f172a;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="600" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- CONNECTING ARROWS BETWEEN COMPONENTS -->
        <mxCell id="e_app_to_api" value="HTTP / JSON" edge="1" source="cls_apiclient" target="cls_server" parent="1" style="strokeColor=#0284c7;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_server_to_planner" edge="1" source="cls_server" target="cls_journeyplanner" parent="1" style="strokeColor=#16a34a;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
