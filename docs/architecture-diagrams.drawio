        <mxCell id="e_planner_to_eta" edge="1" source="cls_journeyplanner" target="cls_etaengine" parent="1" style="strokeColor=#16a34a;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_api_to_db" value="SQL Queries (pg pool)" edge="1" source="cls_dbpool" target="cls_tbl_traveltimes" parent="1" style="strokeColor=#c026d3;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
